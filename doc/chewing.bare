# static_dict.bin
# ===============
# Trie dictionary for bopomofo to words conversion

type StaticDictFileMagic struct {
    magic: data[4]                # CHSD
    file: StaticDictFile
}

type StaticDictFile union {StaticDictFileV1}

type StaticDictFileV1 struct {
    header: StaticDictHeader
    index: data
    words: data
}

type StaticDictHeader struct {
    flags: u32
}

type StaticDictIndex struct {
    nodes: list<StaticDictIndexNode>
}

type StaticDictIndexNode struct {
    child_start: u32
    child_len: u16
    syllable: u16
}

# If the last 2 bytes are all zeros then the node can be
# reinterpreted as a leaf node.
type StaticDictIndexLeafNode struct {
    data_start: u32
    data_len: u16
    reserved: u16
}

# static_lm.bin
# ============================================
# bigram + unigram in compressed sparse row format

type StaticLMFileMagic struct {
    magic: data[4]                # CHLM
    file: StaticLMFile
}

type StaticLMFile union {StaticLMFileV1}

type StaticLMFileV1 struct {
    header: StaticLMHeaderV1,
    index: StaticLMIndexV1,
}

type StaticLMHeaderV1 struct {
    flags: u32
    num_rows: u32
    num_values: u64
}

type StaticLMIndexV1 {
    r: list<u32>[num_rows]
    v: list<u32>[num_values]
    c: list<u32>[num_values]
}

# history_freq.bin
# ============================================

type HistoryFreqFileMagic struct {
    magic: data[4]                 # CHHF
    file: HistoryFreqFile
}

type HistoryFreqFile union {HistoryFreqFileV1}

type HistoryFreqFileV1 struct {
    header: HistoryFreqHeaderV1,
    payload: HistoryFreqListV1,
}

type HistoryFreqHeader struct {
    flags: u32
    half_life: u32
    generation: u64
    count: u32
}

type HistoryFreqList struct {
    history: list<HistoryFreqEntry>[count]
}

type HistoryFreqEntry struct {
    word: str
    c_i: u32
    b_i: u64
}

# history_dict.bin
# ============================================

type HistoryDictFileMagic struct {
    magic: data[4]               # CHHD
    file: HistoryDictFile
}

type HistoryDictFile union {HistoryDictFileV1}

type HistoryDictFileV1 struct {
    header: HistoryDictHeader,
    payload: HistoryDictList,
}

type HistoryDictHeader struct {
    flags: u32
    count: u32
}

type HistoryDictList struct {
    records: list<HistoryDictEntry>[count]
}

type HistoryDictEntry struct {
    syllables: list<u16>
    word: str
}
